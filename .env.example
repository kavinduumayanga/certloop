# CertLoop environment template
# Copy this file to .env, fill in the Gmail credentials, and restart the backend.
# Never commit the resulting .env file.

# Application server
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Storage and uploads
DATABASE_URL=sqlite:///./data/certificates.db
DATA_DIR=./data
MAX_UPLOAD_MB=25

# Delivery safeguards
# Delivery is intentionally sequential for Gmail safety.
DELIVERY_CONCURRENCY=1
# Optional application cap over a rolling 24-hour window.
# Leave blank to monitor activity without enforcing an application-level cap.
# Your SMTP provider's limits remain authoritative.
MAX_EMAILS_PER_DAY=
EMAIL_SEND_DELAY_SECONDS=5
MIN_EMAIL_SEND_DELAY_SECONDS=5
MAX_EMAIL_SEND_DELAY_SECONDS=120
HEALTHY_SENDS_BEFORE_SPEEDUP=5

# Gmail SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail account that owns the App Password.
SMTP_USERNAME=your.name@gmail.com
# Google-generated 16-character App Password; spaces are accepted.
SMTP_APP_PASSWORD=
# Primary From address, normally the same as SMTP_USERNAME.
SMTP_SENDER_EMAIL=your.name@gmail.com
# Optional comma-separated addresses already verified in Gmail "Send mail as".
SMTP_ALLOWED_ALIASES=

# SMTP connection behavior
SMTP_TIMEOUT_SECONDS=30
SMTP_DATA_TIMEOUT_SECONDS=300
SMTP_CONNECTION_REUSE=true
SMTP_MAX_MESSAGES_PER_CONNECTION=25
# CertLoop intentionally permits one SMTP worker.
SMTP_WORKERS=1
